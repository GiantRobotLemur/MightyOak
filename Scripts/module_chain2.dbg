# module_chain2.dbg - Check module chain before and during the stall
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

# Check module chain at various boot stages
echo === Module chain at 10M cycles ===
run 10000000
mem 0x00000100 32

echo === Module chain at 50M cycles ===
run 40000000
mem 0x00000100 32

echo === Module chain at 100M cycles ===
run 50000000
mem 0x00000100 32

echo === Module chain at 130M cycles ===
run 30000000
mem 0x00000100 32

echo === Module chain at 135M cycles ===
run 5000000
mem 0x00000100 32

echo === Module chain at 136M cycles ===
run 1000000
mem 0x00000100 32

echo === Module chain at 136.5M cycles ===
run 500000
mem 0x00000100 32

echo === Module chain at 136.9M cycles ===
run 400000
mem 0x00000100 32

echo === Module chain at 137M cycles ===
run 100000
mem 0x00000100 32
pc
