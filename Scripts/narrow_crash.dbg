# narrow_crash.dbg - Find exactly when the boot crash occurs
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === Running to 120M cycles ===
run 120000000
pc
reg r8

echo === Running to 130M cycles ===
run 10000000
pc
reg r8

echo === Running to 135M cycles ===
run 5000000
pc
reg r8

echo === Running to 140M cycles ===
run 5000000
pc
reg r8

echo === Running to 142M cycles ===
run 2000000
pc
reg r8

echo === Running to 144M cycles ===
run 2000000
pc
reg r8

echo === Running to 146M cycles ===
run 2000000
pc
reg r8

echo === Running to 148M cycles ===
run 2000000
pc
reg r8

echo === Running to 150M cycles ===
run 2000000
pc
reg r8

echo === Running to 155M cycles ===
run 5000000
pc
reg r8

echo === Running to 160M cycles ===
run 5000000
pc
reg r8

echo === Running to 170M cycles ===
run 10000000
pc
reg r8
regs

echo === Read exception vector table pointers ===
mem 0x00000100 64
