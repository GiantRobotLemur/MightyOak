# step_crash4.dbg - Find exact crash instruction
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137340000
step 3800
echo === After 3800 steps ===
pc
regs

step 10
echo === +3810 ===
pc

step 10
echo === +3820 ===
pc

step 10
echo === +3830 ===
pc

step 10
echo === +3840 ===
pc

step 10
echo === +3850 ===
pc

step 10
echo === +3860 ===
pc

step 10
echo === +3870 ===
pc

step 10
echo === +3880 ===
pc

step 10
echo === +3890 ===
pc
regs
trace 30
