# step_precise.dbg - Find exact crash point between 5K step batches 1 and 2
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137000000

echo === At 137M, stepping first 5K ===
step 5000
pc

echo === Now stepping in 500-instruction batches ===
step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc

step 500
pc
