# verify_quick.dbg - Quick verification past old crash points
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === Running 150M cycles (past all previous crash points) ===
run 150000000
echo === 150M: ===
pc
regs

echo === Running to 200M ===
run 50000000
echo === 200M: ===
pc

echo === Running to 250M ===
run 50000000
echo === 250M: ===
pc

echo === Running to 300M ===
run 50000000
echo === 300M: ===
pc
regs
trace 30
