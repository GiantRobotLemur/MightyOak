# narrow_crash2.dbg - Find when the boot crashes between 150M and 300M cycles
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 150000000
echo === 150M: ===
pc

run 10000000
echo === 160M: ===
pc

run 10000000
echo === 170M: ===
pc

run 10000000
echo === 180M: ===
pc

run 10000000
echo === 190M: ===
pc

run 10000000
echo === 200M: ===
pc

run 10000000
echo === 210M: ===
pc

run 10000000
echo === 220M: ===
pc

run 10000000
echo === 230M: ===
pc

run 10000000
echo === 240M: ===
pc

run 10000000
echo === 250M: ===
pc
