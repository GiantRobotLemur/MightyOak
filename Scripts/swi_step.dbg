# swi_step.dbg - Step through SWI dispatch one instruction at a time
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137000000

echo === Skip to SWI instruction at 0x03811DB0 ===
step 13650
pc

echo === Step to the SWI instruction ===
step 1
pc
step 1
pc
step 1
pc
step 1
pc
regs

echo === SWI instruction about to execute, examine table entry ===
echo === SWI table entry for 0x1D at logical 0x01F03470 ===
mem 0x01F03468 16

echo === Execute the SWI ===
step 1
pc
regs

echo === Now in SWI handler, step through dispatch ===
step 1
pc
regs

step 1
pc

step 1
pc

step 1
pc

step 1
pc
regs

step 1
pc

step 1
pc

step 1
pc

step 1
pc

step 1
pc
regs

echo === R11 should be SWI number, check it ===
reg r11

step 1
pc

step 1
pc
regs

echo === This should be the LDRCC R15 - check R15 and flags ===
step 1
pc
regs

echo === Where did we land? ===
step 1
pc
regs

step 1
pc

step 1
pc

step 1
pc
regs
