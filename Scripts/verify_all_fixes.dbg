# verify_all_fixes.dbg - Verify boot progress after all 3 fixes
# Fix 1: R14 pipeline offset in raiseException()
# Fix 2: LDR Rd=Rn writeback priority
# Fix 3: GT condition code evaluation
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === Running 100M cycles ===
run 100000000
pc

echo === Running to 200M cycles ===
run 100000000
pc

echo === Running to 300M cycles ===
run 100000000
pc

echo === Running to 400M cycles ===
run 100000000
pc

echo === Running to 500M cycles ===
run 100000000
pc

echo === Running to 600M cycles ===
run 100000000
pc

echo === Running to 700M cycles ===
run 100000000
pc

echo === Running to 800M cycles ===
run 100000000
pc

echo === State at 800M ===
regs
irq
trace 50
