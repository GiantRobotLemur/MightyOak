# step_crash3.dbg - Narrow crash within 3000-4000 step range
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137340000
step 3000
echo === After 3000 steps ===
pc

step 100
echo === +3100 ===
pc

step 100
echo === +3200 ===
pc

step 100
echo === +3300 ===
pc

step 100
echo === +3400 ===
pc

step 100
echo === +3500 ===
pc

step 100
echo === +3600 ===
pc

step 100
echo === +3700 ===
pc

step 100
echo === +3800 ===
pc

step 100
echo === +3900 ===
pc
trace 50
