# step_crash.dbg - Step through the crash transition at ~137M
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137000000

echo === At 137M: stepping in 5K instruction batches ===
step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8

step 5000
pc
reg r8
