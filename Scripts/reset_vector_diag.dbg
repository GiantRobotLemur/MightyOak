# reset_vector_diag.dbg - Inspect the ROM reset vector and surrounding code
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === ROM Reset Vector (physical) ===
disasm 0x03800000 16 phys
mem 0x03800000 64 phys

echo === ROM entry point at 0x038001AC (physical) ===
disasm 0x038001AC 32 phys

echo === Code around 0x038022C0 (where the fatal branch is) ===
disasm 0x038022A0 32 phys

echo === Run 150M cycles to reach keyboard init ===
run 150000000
regs

echo === ROM Reset Vector after 150M cycles (check for corruption) ===
mem 0x03800000 64 phys
disasm 0x03800000 8 phys

echo === What is at logical address 0 (mapped RAM)? ===
mem 0x00000000 64

echo === Exception vectors in logical space ===
disasm 0x00000000 8

echo === Run another 50M cycles ===
run 50000000
regs
pc
trace 30
