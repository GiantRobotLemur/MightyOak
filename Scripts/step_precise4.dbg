# step_precise4.dbg - Catch the exact crash between 13650 and 13700 instructions
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137000000

echo === Skip 13650 instructions ===
step 13650
pc
regs

echo === +10 (13660) ===
step 10
pc

echo === +10 (13670) ===
step 10
pc

echo === +10 (13680) ===
step 10
pc

echo === +10 (13690) ===
step 10
pc

echo === +10 (13700) ===
step 10
pc
trace 100
regs
