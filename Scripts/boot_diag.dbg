# boot_diag.dbg - Initial RISC OS 3.10 boot diagnosis
# Determine where and why the boot process stalls.

config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === Phase 1: Early ROM init (10K cycles) ===
run 10000
pc
regs

echo === Phase 2: Run to 100K cycles ===
run 90000
pc
regs
irq

echo === Phase 3: Run to 1M cycles ===
run 900000
pc
regs
irq
memc

echo === Phase 4: Run to 10M cycles ===
run 9000000
pc
regs
irq
memc

echo === Phase 5: Run to 50M cycles ===
run 40000000
pc
regs
irq
memc

echo === Phase 6: Run to 150M cycles ===
run 100000000
pc
regs
irq
memc

echo === Phase 7: Run to 500M cycles ===
run 350000000
pc
regs
irq

echo === Last 50 traced instructions ===
trace 50

echo === MEMC final state ===
memc

echo === IOC final state ===
ioc
