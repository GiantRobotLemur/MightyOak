# verify_fix3.dbg - Verify both R14 and LDR Rd=Rn fixes
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

echo === Running to 150M cycles (past both old crash points) ===
run 150000000
pc
regs

echo === Running to 300M cycles ===
run 150000000
pc
regs

echo === Running to 500M cycles ===
run 200000000
pc
regs
trace 30
irq
