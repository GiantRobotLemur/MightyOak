# swi_table_diag.dbg - Examine the SWI dispatch table and MEMC mappings at crash point
config model Archimedies
config cpu ARM2
config rom RiscOS_3_10
config ram 4096
init

run 137000000

echo === Skip to just before SWI call ===
step 13600

echo === Current state (should be near 0x03811DA0) ===
pc
regs

echo === SWI table at 0x01F03400 - kernel SWI jump table ===
mem 0x01F03400 128

echo === SWI table entry for SWI 0x1D at 0x01F03470 ===
mem 0x01F03460 32

echo === Module SWI table at 0x790 ===
mem 0x00000780 128

echo === MEMC page mappings ===
memc

echo === Error handler vector table (where R10 null comes from) ===
echo === R14 at 0x0380a1d8 points to table, R10=24 indexes it ===
echo === The LDR at 0x0380a1d8 loads from [R14-0x1C] = the table base ===
disasm 0x0380a1c0 16

echo === Check exception vectors at address 0 ===
mem 0x00000000 32
disasm 0x00000000 8

echo === Physical memory at 0x02000000 (first page of physical RAM) ===
mem 0x02000000 64 phys
