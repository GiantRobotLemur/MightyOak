; ARM/MEMC Test ROM Image
; A ROM image to test an ARM-based system running on MEMC/IOC/VIDC hardware
; as part of the MightyOak project

; RAM Layout:
; 0x0000000 - HW Vector Table (8 entries = 32 bytes)
; 0x0000020 - HW Vector handler addresses (8 entries = 32 bytes)
.HW_IRQ_Handlers    0x0020
; 0x0000040 - IRQ handler table (16 entries = 64 bytes)
.IRQ_Handlers       0x0040
; 0x0000080 - FIRQ handler table (8 entries = 32 bytes)
.FIRQ_Handlers      0x0080
; 0x00000A0 - KRT Tx Buffer - 32 bytes
.KRT_TxBuffer       0x00A0
; 0x00000C0 - KRT Rx Buffer - 32 bytes
.KRT_RxBuffer       0x00C0
; ...
.OS_Workspace       0x8000      ; ? KB
.SVC_StackTop       0x8000      ; 32 KB
.FIRQ_StackTop      0x7000      ; 28 KB
.IRQ_StackTop       0x6000      ; 24 KB
.USR_StackTop       0x5000      ; 20 KB
.USR_StackBase      0x4000      ; 16 KB

; 0x0004000 - Bottom of user mode stack - 4 KB
; 0x0005000 - Top of user mode stack, bottom of IRQ mode stack - 4 KB
; 0x0006000 - Top of IRQ mode stack, bottom of FIRQ mode stack - 4 KB
; 0x0007000 - Top of FIRQ mode stack, bottom of SVC mode stack - 4 KB
; 0x0008000 - Top of SVC mode stack, start of OS Workspace.

; Define offsets within OS_Workspace
.OS_BootState   0           ; Stores the current state of the boot process.
.OS_RamSize     4           ; Detected physical RAM size in bytes
.OS_SysCtrlID   8           ; Value of CP15->CR0, or a made up value if not present.
.OS_KRT_TxHead  12          ; Write index into KRT Tx circular buffer
.OS_KRT_TxTail  16          ; Read index into KRT Tx circular buffer
.OS_KRT_RxHead  20          ; Write index into KRT Rx circular buffer
.OS_KRT_RxTail  24          ; Read index into KRT Rx circular buffer

.BOOT_Started       0       ; The boot-up process has started
.BOOT_MemDetected   1       ; OS workspace set up, RAM size detected.
.BOOT_StacksInit    2       ; The various processor mode stacks are set.
.BOOT_HwVectorsSet  3       ; Hardware vectors initialised in RAM.
.BOOT_CPUDetected   4       ; CPU detection complete.
.BOOT_IOCInit       5       ; IOC initialisation complete.
.BOOT_KARTInit      6       ; KART initialisation complete.
.BOOT_KbdInit       7       ; Keyboard initialisation complete.

.BOOT_Completed     100     ; The last state before halting.

; IOC-based definitions.
.IOC_BaseAddr       0x3200000
.IOC_CONTROL        0x00
.IOC_KART_TX        0x04
.IOC_KART_RX        0x04
.IOC_IRQ_STATUS_A   0x10
.IOC_IRQ_REQUEST_A  0x14
.IOC_IRQ_CLEAR_A    0x14
.IOC_IRQ_MASK_A     0x18
.IOC_IRQ_STATUS_B   0x20
.IOC_IRQ_REQUEST_B  0x24
.IOC_IRQ_MASK_B     0x28
.IOC_FIRQ_STATUS    0x30
.IOC_FIRQ_REQUEST   0x34
.IOC_FIRQ_MASK      0x38

.IOC_T0_LATCH_LO    0x40
.IOC_T0_LATCH_HI    0x44
.IOC_T0_GO          0x48
.IOC_T0_LATCH       0x4C

; T3 is used to control the KART baud rate.
.IOC_T3_LATCH_LO    0x70
.IOC_T3_LATCH_HI    0x74
.IOC_T3_GO          0x78
.IOC_T3_LATCH       0x7C

; At power-on, the low ROM is mapped to address 0x00000000, so the start of
; the ROM image needs to be the hardware vector table.
; See ARM Family Data Manual Page 2-28 (50)
B Initial_Reset
B Initial_HandleUndefInstruction
B Initial_HandleSoftwareIrq
B Initial_HandlePrefetchAbort
B Initial_HandleDataAbort
B Initial_HandleAddressException
B Initial_HandleIrq

; The last entry executes the handler for FIRQs
.Initial_HandleFirq

; For the moment, any exception or trap will cause
; an infinite loop.
.Initial_HandleUndefInstruction
.Initial_HandleSoftwareIrq
.Initial_HandlePrefetchAbort
.Initial_HandleDataAbort
.Initial_HandleAddressException
.Initial_HandleIrq

.Infinite_Loop
    BKPT 0                                ; Break point to stop execution.
    B Infinite_Loop

; Run at power-on. Low ROM (this) is mapped to 0x00000000
; Running in SVC mode, IRQs and FIRQs are disabled.
.Initial_Reset
    ADR R0,Reset_MEMC                   ; Calculate the address of the ROM entry point.
    ADD R0,R0,#0x03400000 OR 0x0C000000 ; Add the Low ROM base address plus PSR bits to disable IRQs.
    ORR R0,R0,#3                        ; Ensure we remain in SVC mode.
    MOVS PC,0                           ; Jump to the same code running at the
                                        ;   ROM's native location and update the PSR.

.Reset_MEMC
; MEMC - Effect of Reset - ARM Family Data Manual Page 4-9 (193)
; The process or starts executing code from location 0000000H after RES goes
; inactive. To ensure the processor always finds valid code at this location
; (which is normally logically mapped RAM), MEMC continually enables ROM.
;
; To restore the normal memory map, the processor must first access the address
; lines A25 and A24 both low and then perform a memory access with address line
; A25 high.
;
; These conditions are satisfied when the processor starts executing
; instructions from 0000000h, and later jumps to the normal ROM space.
;
; - ROM access times - The ROM access times for both high and low ROM are
;   reset to 450ns
; - Pages sizes - The DRAM page size defaults to 4 Kbytes on reset.
; - Operating System mode - The Operating system mode is disabled on reset.
; - Direct Memory Access (DMA) operations - Sound DMA operations are disabled
;   by reset, and may be enabled by programming the MEMC Control Register.
;   Video and cursor operations are unaffected by reset.
; - Sound Interrupts - The sound interrupt pin, -SIRQ is set low on reset. The
;   interrupt may be removed by initializing the sound DMA buffers in the DMA
;   address generator.
; - The processor may generate spurious addresses while RES is active high. To
;   avoid accidentally triggering an I/O controller, the -IORQ signal is held
;   high during reset.
; - The Test mode (used in functional testing) is disabled by RES. Test mode
;   maybe set by programming the MEMC control register, but will crash the
;   system; control is regained by resetting MEMC.

; Calculate memory size by accessing physically mapped RAM between addresses
; 0x2000000 and 0x3000000.
    MOV R0,#0x2000000                   ; Set the base address
    MOV R1,#4096                        ; Set the address increment.
    MOV R2,R1                           ; Initialise the memory size.
    LDR R3,Reset_MEMC_Markers           ; Cache the marker values in memory.
    LDR R4,Reset_MEMC_Markers + 4
    B Reset_MEMC_SizeLoop               ; Start memory size detection.

.Reset_MEMC_Markers
    EQUD 0xAA55AA55
    EQUD 0x55AA55AA

.Reset_MEMC_SizeLoop
    CMP R2,#0x1000000                   ; See if we have reached the 16 MB mark.
    BGE Reset_MEMC_SizeLoopEnd          ; Branch if we reached the limit.

    STR R3,[R0]                         ; Set the value at physical RAM base.
    STR R4,[R0,R2]                      ; Store a different value at the
                                        ;   target address
    LDR R5,[R0]                         ; Load the value from physical RAM base.
    CMP R5,R4                           ; Does Phys[0x0000] == Phys[Target] ?
    BEQ Reset_MEMC_SizeLoopEnd
    LDR R5,[R0,R2]                      ; Load the value at test location.
    CMP R5,R4                           ; Did the target RAM location retain
                                        ;   the value we wrote?
    BNE Reset_MEMC_SizeLoopEnd
    ADD R2,R2,R1                        ; Increment the memory size.
    B Reset_MEMC_SizeLoop               ; Go around again.

.Reset_MEMC_SizeLoopEnd
; RAM size in bytes is in R2.
    MOV R11,R2                          ; Stash the RAM size out of the way.

; Initially, identity map the first 1 Mb using 8 Kb pages.
    MOV R0,#0x3000000                   ; Make up an address 0x036E0004 to
    ORR R0,R0,#0x6E0000                 ;   program the MEMC control register
    ORR R0,R0,#4                        ;   for 8 KB pages, normal RAM/ROM
                                        ;   access times and no DMA.
    STR R2,[R0]                         ; Write the MEMC control register by
                                        ;   writing to the address we made up.

    MOV R0,#0x3800000                   ; Set the base address from address
                                        ;   mapping Content Addressable Memory (CAM)
    MOV R1,#0                           ; Initialise the counter.
    MOV R6,#1 << 10                     ; Set the mask to get LPN bits [9:0]
    SUB R6,R6,#1                        ; Make a 10-bit mask.
.Reset_MEMC_AddrMapInitLoop8KB
    MOV R2,R0                           ; Create a new mapping
    AND R4,R1,#0x3F                     ; Get bits PPN [5:1]
    ORR R2,R2,R4,LSL #1                 ; Set the physical page number.
    AND R3,R1,#0x40                     ; Extract the MSB of the page no.
    ORR R2,R2,R3,LSR #6                 ; Store the LSB at bit 6

    AND R4,R1,R6                        ; Extract LPN [9:0]
    ORR R2,R2,R4,LSL #13                ; Set the logical page number.
    AND R4,R1,#0xC00                    ; Extract LPN [11:10]
    ORR R2,R2,R4,LSL #10                ; Set the upper bits of the LPN.

    STR R2,[R2]                         ; Access the address we calculated to
                                        ;   set the mapping in CAM.
    ADD R1,R1,#1                        ; Increment the page counter.
    CMP R1,#128
    BLT Reset_MEMC_AddrMapInitLoop8KB

.Init_Hardware_Vectors
; The addresses 0x000000 - 0x100000 are now identity mapped.
; Set up independent stacks for the various operating modes.
    MOV R12,#OS_Workspace               ; Set up workspace at the 32 KB mark.
    MOV R0,#BOOT_MemDetected            ; Set the current boot state
    STR R11,[R12,#OS_RamSize]           ; Store the RAM size
    STR R0,[R12,#OS_BootState]          ; Store the boot state
    MOV R2,R12                          ; Take a copy of the workspace to
                                        ;   install in other register banks.

    MOV R13,#SVC_StackTop               ; Set up the supervisor (current) mode stack.
    SUB R13,R13,#4                      ; Create a full-descending supervisor stack.

    MOV R0,PC                           ; Get the PSR bits
    TEQP R0,#2                          ; Switch to FIRQ mode
    MOV R0,R0                           ; Non-op after mode change.
    MOV R13,#FIRQ_StackTop              ; Initialise the FIRQ stack.
    SUB R13,R13,#4
    MOV R12,R2                          ; Give FIRQ mode access to OS_Workspace

    MOV R0,PC                           ; Get the PSR bits
    TEQP R0,#3                          ; Switch to IRQ mode.
    MOV R0,R0                           ; Non-op after mode change.
    MOV R13,#IRQ_StackTop               ; Initialise the IRQ stack.
    SUB R13,R13,#4

    ; Initialise the user mode stack pointer without switching to user mode.
    MOV R0,PC                           ; Gest the PSR bits
    TEQP R0,#1                          ; Switch back to SVC mode.
    MOV R0,#USR_StackTop                ; Calculate the top of the user mode stack.
    SUB R0,R0,#4
    STMFD SP!,{R0}                      ; Store the user stack pointer on the SVC stack.
    LDMIA SP,{SP}^                      ; Load the user mode SP into the user
                                        ;   register bank. We can't use write-back.
    MOV R0,R0                           ; A non-op due to register banking issues.
    ADD SP,SP,#4                        ; Restore the SVC stack.

    MOV R0,#BOOT_StacksInit             ; Set the current boot state
    STR R0,[R12,#OS_BootState]          ; Store the boot state

; We need to write instructions into the RAM-based hardware vectors to handle
; exceptions and interrupts.
    MOV R0,#0                           ; Overwrite the reset vector
    ADR R1,Do_HandleReset
    BL Write_HW_Vector

    MOV R0,#1                           ; Overwrite the undefined instruction vector.
    ADR R1,Do_HandleUndefInstruction
    BL Write_HW_Vector

    MOV R0,#2                           ; Overwrite the software interrupt vector.
    ADR R1,Do_HandleSoftwareIrq
    BL Write_HW_Vector

    MOV R0,#3                           ; Overwrite the pre-fetch abort vector.
    ADR R1,Do_HandlePrefetchAbort
    BL Write_HW_Vector

    MOV R0,#4                           ; Overwrite the data abort vector
    ADR R1,Do_HandleDataAbort
    BL Write_HW_Vector

    MOV R0,#5                           ; Overwrite the address exception vector
    ADR R1,Do_HandleAddressException
    BL Write_HW_Vector

    MOV R0,#6                           ; Overwrite the interrupt vector
    ADR R1,Do_HandleIrq
    BL Write_HW_Vector

    MOV R0,#7                           ; Overwrite the fast interrupt vector
    ADR R1,Do_HandleFirq
    BL Write_HW_Vector

    MOV R0,#BOOT_HwVectorsSet           ; Set the current boot state
    STR R0,[R12,#OS_BootState]          ; Store the boot state

    ; Initialise interrupt handlers
    MOV R11,#IRQ_Handlers
    MOV R0,#0
    ADR R1,DefaultIrqHandler            ; Set handlers to the default
.FillIrqHandlerLoop
    STR R1,[R11,R0,LSL#2]               ; Store the handler
    ADD R0,R0,#1                        ; Increment the index
    CMP R0,#16                          ; Check against the limit
    BLT FillIrqHandlerLoop

    ; Initialise fast interrupt handlers
    MOV R11,#FIRQ_Handlers              ; Initialise to set FIRQ handlers
    MOV R0,#0
.FillFirqHandlerLoop
    STR R1,[R11,R0,LSL#2]               ; Store the handler
    ADD R0,R0,#1                        ; Increment the index
    CMP R0,#8                           ; Check against the limit
    BLT FillFirqHandlerLoop

    B Detect_CPU

; Writes a branch instruction into a hardware vector encoding
; LDR PC,[PC,#24] to perform a full 32-bit branch via an address
; stored after the hardware vector table. This is because a branch
; instruction only has a range if +/- 32MB, which is too far from
; the base of the logical address space to the low ROM (~52 MB)
;
; The new vector address will be stored at the vector location + 32
; Entry:    R0 = HW Vector Number
;           R1 = Handler address
.HW_Vector_Instruction
    EQUD 0xE59FF018

.Write_HW_Vector
    STMFD SP!,{R0-R2,Link}
    MOV R2,R0,LSL #2                    ; Calculate the hardware vector address.
    STR R1,[R2,#32]                     ; Store the address of the handler after
                                        ;   the hardware vector table.
    LDR R1,HW_Vector_Instruction        ; Load the instruction pattern
    STR R1,[R2]                         ; Store it in the hardware vector.

    LDMFD SP!,{R0-R2,PC}                ; Return

.Detect_CPU
    MOVS R5,PC                          ; Get a copy of the PSR.
    AND R5,R5,#0xFC000003               ; Mask out PC bits.
    ADRL R4,Reset_IOC                   ; Set a new target PC
    ORR R4,R4,R5                        ; Merge in the saved PSR bits.
    STMFD SP!,{R4}                      ; Save the branch target for later re-use.

    MOV R0,#1                           ; Overwrite the Undefined instruction
    ADR R1,DetectCPU_NoCP15             ;   hardware vector before reading CP15
    BL Write_HW_Vector
    MRC CP15,0,R0,CR0,0,0               ; Copy CP15.CR0 to R0
    STR R0,[R12,#OS_SysCtrlID]          ; Store the value.
    B DetectCPU_RestoreVector

.DetectCPU_ARM2_ID
    EQUD 0x41560100                     ; The CP15.CR0 value for an ARM 2
.DetectCPU_ARM2sA_ID
    EQUD 0x41560200                     ; The CP15.CR0 value for an ARM 250

.DetectCPU_NoCP15                       ; If we get here, the MCR instruction faulted.
    LDR Link,[SP]                       ; Restore the previous return address.
    LDR R8,DetectCPU_ARM2_ID
    STR R8,[R12,#OS_SysCtrlID]          ; Store the generated ID.

    ; There is no CP15, but see if the SWP instruction is supported.
    MOV R0,#1                           ; Overwrite the Undefined instruction
    ADR R1,DetectCPU_NoSwp              ;   hardware vector before reading CP15
    BL Write_HW_Vector

    ADD R11,R12,#OS_SysCtrlID           ; Prepare to swap the ARM2sa ID in memory.
    LDR R10,DetectCPU_ARM2sA_ID
    SWP R9,R10,[R11]                    ; Swap the old CPU ID with an ARM2sa ID
    B DetectCPU_RestoreVector

.DetectCPU_NoSwp                        ; If we get here, the SWP instruction faulted.
    LDR Link,[SP]                       ; Restore the previous return address.

.DetectCPU_RestoreVector
    MOV R0,#1                           ; Overwrite the undefined instruction vector.
    ADR R1,Do_HandleUndefInstruction
    BL Write_HW_Vector

    MOV R0,#BOOT_CPUDetected            ; Set the current boot state
    STR R0,[R12,#OS_BootState]          ; Store the boot state

    LDMFD SP!,{PC}^                     ; Branch to Reset_IOC and restore PSR flags.

.Do_HandleReset
    BKPT 100                            ; Break point to stop execution.
    B Do_HandleReset                    ; Infinite loop.

.Do_HandleUndefInstruction
    BKPT 101                            ; Break point to stop execution.
    B Do_HandleUndefInstruction         ; Infinite loop.

.Do_HandleSoftwareIrq
    BKPT 102                            ; Break point to stop execution.
    B Do_HandleSoftwareIrq              ; Infinite loop.

.Do_HandlePrefetchAbort
    BKPT 103                            ; Break point to stop execution.
    B Do_HandlePrefetchAbort            ; Infinite loop.

.Do_HandleDataAbort
    BKPT 104                            ; Break point to stop execution.
    B Do_HandleDataAbort                ; Infinite loop.

.Do_HandleAddressException
    BKPT 105                            ; Break point to stop execution.
    B Do_HandleAddressException         ; Infinite loop.

.Do_HandleIrq
    ; TODO : Figure out which IRQ was triggered and branch to handler from the table.
    STMFD SP!,{R0-R4,R14}               ; Store some registers to process the
                                        ;   interrupt transparently.
    ; IRQs are mapped to specific HW, 0-7 on IOC IRQ A registers and 8-15 on IOC IRQ B registers
    ; See RiscOS PRM 1-121.
    ;
    ; Archimedes hardware:
    ; 0  - IRQ A0 - Printer Busy
    ; 1  - IRQ A1 - Serial port Ring Indicator
    ; 2  - IRQ A2 - Printer Ack
    ; 3  - IRQ A3 - VSync pulse
    ; 4  - IRQ A4 - Power on reset
    ; 5  - IRQ A5 - Timer 0
    ; 6  - IRQ A6 - Timer 1
    ; 7  - IRQ A7 - Not connected
    ; 8  - IRQ B0 - Expansion card FIRQ downgrade
    ; 9  - IRQ B1 - Sound buffer change
    ; 10 - IRQ B2 - Serial port controller
    ; 11 - IRQ B3 - HD controller
    ; 12 - IRQ B4 - FD controller
    ; 13 - IRQ B5 - Expansion card
    ; 14 - IRQ B6 - KRT Tx complete
    ; 15 - IRQ B7 - KRT Rx complete
    ;
    ; A-Series hardware:
    ; 0  - IRQ A0 - 82c710/711 Parallel port
    ; 1  - IRQ A1 - Low battery warning
    ; 2  - IRQ A2 - FD index pulse
    ; 3  - IRQ A3 - VSync pulse
    ; 4  - IRQ A4 - Power on reset
    ; 5  - IRQ A5 - Timer 0
    ; 6  - IRQ A6 - Timer 1
    ; 7  - IRQ A7 - Not connected
    ; 8  - IRQ B0 - Expansion card FIRQ downgrade
    ; 9  - IRQ B1 - Sound buffer change
    ; 10 - IRQ B2 - 82c710/711 Serial port - FIRQ 4
    ; 11 - IRQ B3 - 82c710/711 IDE controller
    ; 12 - IRQ B4 - 82c710/711 FD controller
    ; 13 - IRQ B5 - Expansion card
    ; 14 - IRQ B6 - KRT Tx complete
    ; 15 - IRQ B7 - KRT Rx complete
.DetectIRQsPending
    MOV R4,#IOC_BaseAddr
    LDRB R0,[R4,#IOC_IRQ_REQUEST_A]     ; See which IRQs are requested from register A.
    LDRB R1,[R4,#IOC_IRQ_REQUEST_B]     ; See which IRQs are requested from register B.
    ORRS R1,R0,R1,LSL #8                ; Combine the request registers
    BEQ FinishIrq                       ; If the result was zero, exit.
    MOV R0,#0                           ; Init scanning which IRQs are pending
    MOV R2,#1                           ; Init the mask to test.
    ADR R14,ScanNextIRQ                 ; Set the return address from any handler executed

.ScanPendingIrqsLoop
    TST R1,R2,LSL R0                    ; Test to see if the bit is set.
    MOVNE R4,#IRQ_Handlers              ;   Get the address of the IRQ handler table
    LDRNE PC,[R4,R0,LSL #2]             ;   Run the handler address at the address
                                        ;     having already set the return to ScanNextIRQ.

.ScanNextIRQ
    MOV R4,R2,LSL R0                    ; Get the bit mask for the IRQ
    ANDS R4,R4,#0x7C                    ; See if the IRQ needs clearing in IOC
    MOVNE R3,#IOC_BaseAddr              ;   If the bit remains set,
    STRNEB R4,[R3,#IOC_IRQ_CLEAR_A]     ;   write it to the IOC IRQ clear register.

    BICS R1,R1,R2,LSL R0                ; Clear the bit
    BEQ DetectIRQsPending               ; If no more bit set, try again.
    ADD R0,R0,#1                        ; Increment the IRQ being tested
    B ScanPendingIrqsLoop               ; Check for more outstanding IRQs

.DefaultIrqHandler
    MOV PC,R14                          ; Simply return.

.FinishIrq
    LDMFD SP!,{R0-R4,R14}               ; Restore saved registers before resuming
    SUBS PC,R14,#4                      ;    the interrupted code.

    BKPT 106                            ; Break point to stop execution.
    B Do_HandleIrq                      ; Infinite loop.

.Do_HandleFirq
    ; Figure out which FIRQ was triggered and branch to handler from the table.
    ; I think normally only one is ever unmasked at once and the code is simply
    ;   copied to the end of the HW vector table for maximum speed.
    ;
    ; FIRQs are mapped to specific HW.
    ; See RiscOS PRM 1-121.
    ;
    ; Archimedes hardware: (From A0018017 - A540 Technical Reference Manual, Pg 1-8)
    ; 0  - FD Data Request
    ; 1  - FD Interrupt Request
    ; 2  - Econet Interrupt Request
    ; 3  - C3
    ; 4  - C4
    ; 5  - C5
    ; 6  - Expansion card FIRQ
    ; 7  - Not connected - used for force FIRQ from SW
    ;
    ; A-Series hardware: (From A0018033 - A5000 Technical Reference Manual, Pg 1-14)
    ; 0  - FD Data Request
    ; 1  - not used
    ; 2  - Econet Interrupt Request
    ; 3  - C3
    ; 4  - Serial Line Interrupt
    ; 5  - C5
    ; 6  - Expansion card FIRQ
    ; 7  - Not connected - used for force FIRQ from SW
    STMFD SP!,{R0-R4,Link}              ; Store return and registers for working
    MOV R4,#IOC_BaseAddr
    LDRB R1,[R4,#IOC_FIRQ_REQUEST]      ; See which FIRQs are requested.
    CMP R1,#0                           ; If no FIRQs are pending
    BEQ FinishFirq                      ;    return to the previous running code.

    MOV R0,#0                           ; Else, scan to see which FIRQs are requested.
    MOV R2,#1

.DetectFIRQsPending
    TST R1,R2,LSL R0                    ; Test the FIRQ request bit
    MOVNE R4,#FIRQ_Handlers             ;   Get the address of the IRQ handler table
    ADRNE Link,NextFirq                 ; Set the return to continue the loop
    LDRNE PC,[R4,R0,LSL #2]             ;   Run the handler address at the address
                                        ;     having already set the return to ScanNextIRQ.
.NextFirq
    BICS R1,R1,R2,LSL R0                ; Clear the bit
    BEQ DetectFIRQsPending              ; If no more bit set, try again.
    ADD R0,R0,#1                        ; Increment the IRQ being tested
    B ScanPendingIrqsLoop               ; Check for more outstanding IRQs

.FinishFirq
    LDMFD SP!,{R0-R4,Link}
    SUBS PC,R14,#4                      ; Return to the previously running code.

    BKPT 107                            ; Break point to stop execution.
    B Do_HandleFirq                     ; Infinite loop.

.Reset_IOC
    ; RAM-based hardware vectors are initialised and point to ROM-based
    ; entry points.
    ;
    ; Initialise IOC to disable most interrupts, but enable keyboard I/O.
    MOV R0,#IOC_BaseAddr                ; Address the IOC ctrl register.
    MOV R1,#0xFF                        ; Set pins C0-C5 to be inputs.
    STRB R1,[R0]

    MOV R1,#0                           ; Mask all interrupts
    STRB R1,[R0,#IOC_IRQ_MASK_A]        ; Write IRQ Mask A
    STRB R1,[R0,#IOC_IRQ_MASK_B]        ; Write IRQ Mask B
    STRB R1,[R0,#IOC_FIRQ_MASK]         ; Write FIRQ Mask

    MOV R1,#0x7C                        ; Clear any pending interrupts,
                                        ;   including POR
    STRB R1,[R0,#IOC_IRQ_CLEAR_A]

    ; Read request registers to clear pending IRQs
    LDRB    R1, [R0,#IOC_IRQ_REQUEST_A]
    LDRB    R1, [R0,#IOC_IRQ_REQUEST_B]

    MOV R10,#BOOT_IOCInit               ; Set the current boot state
    STR R10,[R12,#OS_BootState]         ; Store the boot state

    ; A3010/A3020/A4000 Technical Reference manual Page 1-13 (9)
    ;
    ; Keyboard and Mouse
    ; ...
    ; The microcontroller sends data on key operations and mouse
    ; movements to the ARM250 (IOC Kart) over a serial interface.
    ; Data is sent at 32.5 Kbaud using an NRZ bit stream.
    ;
    ; IOC Data Sheet 
    ;
    ; (KART) Initialisation
    ;
    ; After Power-On, the KART is in an undefined state. The KART is
    ; initialised by programming the serial line speed using counter 3 and
    ; performing a read from the Serial Rx Data register, discarding the data
    ; byte. This will clear any outstanding receive interrupt and enable the
    ; KART for the next reception. Finally the Tx Data register should be
    ; written to. This will abort any transmission in progress, cause a new one
    ; to be started and clear any STx interrupt.
    ;
    ; Counter 3 (KART) [ Page 17 (21) ]
    ; ...
    ; The maximum baud rate of 31250 Hz is obtained by programming
    ; latch = 1.
    MOV R1,#1                           ; Set the counter 3 divisor (latch)
    MOV R2,#0                           ;   to 1.
    STRB R1,[R0,#IOC_T3_LATCH_LO]       ; Write latch low
    STRB R2,[R0,#IOC_T3_LATCH_HI]       ; Write latch high
    STR R0,[R0,#IOC_T3_GO]              ; Write a dummy value to the GO command
    LDRB R3,[R0,#IOC_KART_RX]           ; Read from the Serial Rx Data register
                                        ;   to cancel any previous receive.
    STRB R2,[R0,#IOC_KART_TX]           ; Write to the Serial Tx Data register
                                        ;   to reset any previous sent.

    ; Initialise KART circular buffer head/tail pointers to 0
    MOV     R1, #0
    STR     R1, [R12, #OS_KRT_TxHead]
    STR     R1, [R12, #OS_KRT_TxTail]
    STR     R1, [R12, #OS_KRT_RxHead]
    STR     R1, [R12, #OS_KRT_RxTail]

    ; Install interrupt-driven KART handlers into the IRQ handler table
    MOV     R1, #IRQ_Handlers
    ADR     R2, Handle_KART_Tx
    STR     R2, [R1, #14 * 4]           ; IRQ 14 = KART Tx complete
    ADR     R2, Handle_KART_Rx
    STR     R2, [R1, #15 * 4]           ; IRQ 15 = KART Rx complete

    ; Enable IOC interrupt 15 for KART ready to read
    LDRB R1,[R0,#IOC_IRQ_MASK_B]        ; Read IRQ Mask B
    ORR R1,R1,#0x80                     ; Enable IRQs and 15 for KART Rx
    STRB R1,[R0,#IOC_IRQ_MASK_B]        ; Write IRQ Mask B

    MOV R10,#BOOT_KARTInit              ; Set the current boot state
    STR R10,[R12,#OS_BootState]         ; Store the boot state

    MOV R0,PC                           ; Get a copy of the PC + PSR
    TEQP R0,#0x08000000                 ; Enable IRQs on the CPU but remain in
                                        ; SVC mode.

    ; TODO: Setup another timer to run at 100Hz?
    ; Write handler for KART interrupts
    ; Write SWI handler for system functions
    ; Interface with Logging Device
    ; Map logical memory to high RAM so that low RAM
    ;   can be used for VIDC DMA.

; =============================================================
; KEYBOARD INITIALISATION (KART)
;
; Three-phase handshake: HRST, RAK1, RAK2
; =============================================================
; ---- KART protocol bytes ----
.KART_HRST          &FF
.KART_RAK1          &FE
.KART_RAK2          &FD
.KART_RQID          &20
.IRQ_KART_TX        1 << 6
.IRQ_KART_RX        1 << 7
.KRT_BufSize        32
.KRT_BufMask        31

.init_keyboard
    BL      kart_flush_receive          ; Flush any input from the keyboard.

    ; MOV     R1, #IOC_BaseAddr           ; Read the received byte to clear
    ; LDRB    R0, [R1, #IOC_KART_RX]      ;   the Rx IRQ and flush Rx byte.

    MOV     R0, #KART_HRST              ; Send HRST
    BL      kart_buffered_send
    TST     R0,R0                       ; Check for an error on send.
    BNE     keyboard_fail

    BL      kart_buffered_receive_wait  ; Wait for HRST echo
    CMP     R0, #KART_HRST
    BNE     keyboard_fail

    MOV     R0, #KART_RAK1              ; Send RAK1
    BL      kart_buffered_send
    TST     R0,R0                       ; Check for an error on send.
    BNE     keyboard_fail

    BL      kart_buffered_receive_wait  ; Wait for RAK1 echo
    CMP     R0, #KART_RAK1
    BNE     keyboard_fail

    MOV     R0, #KART_RAK2              ; Send RAK2
    BL      kart_buffered_send
    TST     R0,R0                       ; Check for an error on send.
    BNE     keyboard_fail

    BL      kart_buffered_receive_wait  ; Wait for RAK2 echo
    CMP     R0, #KART_RAK2
    BNE     keyboard_fail

; Handshake complete
    MOV R10,#BOOT_KbdInit               ; Set the current boot state
    STR R10,[R12,#OS_BootState]         ; Store the boot state
    B       halt                        ; Finish.

.keyboard_fail
    BKPT    1
    B keyboard_fail

; =============================================================
; KART INTERRUPT HANDLERS
;
; These handlers are installed in the IRQ handler table during
; KART initialisation. They implement interrupt-driven circular
; buffers for keyboard transmit and receive, allowing bytes to
; be queued without polling the IOC hardware registers.
;
; Buffer layout: 32-byte circular buffer with separate head
; (write) and tail (read) indices. Empty when head == tail.
; Full when (head + 1) & mask == tail.
; =============================================================

; -------------------------------------------------------------
; Handle_KART_Tx - IRQ 14 handler
;
; Called when the KART transmitter is ready for a new byte.
; Reads the next byte from the Tx circular buffer and sends it.
; If the buffer is empty, disables the Tx interrupt to avoid
; re-entering until new data is queued.
;
; Entry: Called from IRQ dispatch. R0-R4 are saved by caller.
;        R14 = return address (ScanNextIRQ).
; -------------------------------------------------------------
.Handle_KART_Tx
    STMFD   SP!,{R0-R4}                 ; Preserve state while servicing IRQ.
    MOV     R0,#OS_Workspace
    LDR     R2,[R0,#OS_KRT_TxHead]      ; Get Tx write index
    LDR     R3,[R0,#OS_KRT_TxTail]      ; Get Tx read index
    CMP     R2,R3                       ; Is the buffer empty?
    BEQ     Handle_KART_Tx_Empty        ; Yes - disable Tx IRQ and return.

    MOV     R1,#KRT_TxBuffer            ; Get the Tx buffer base address
    LDRB    R4,[R1,R3]                  ; Read the byte at the tail
    ADD     R3,R3,#1                    ; Advance the tail index
    AND     R3,R3,#KRT_BufMask          ; Wrap around the circular buffer
    STR     R3,[R0,#OS_KRT_TxTail]      ; Store updated tail index

    MOV     R1,#IOC_BaseAddr
    STRB    R4,[R1, #IOC_KART_TX]       ; Send the byte to the KART
    LDMFD   SP!,{R0-R4}                 ; Restore state before exit.
    MOV     PC,R14                      ; Return to IRQ dispatch

.Handle_KART_Tx_Empty
    ; No data to send - mask the Tx interrupt until new data is queued.
    MOV     R1, #IOC_BaseAddr
    LDRB    R2, [R1, #IOC_IRQ_MASK_B]
    BIC     R2, R2, #IRQ_KART_TX        ; Clear the Tx IRQ enable bit
    STRB    R2, [R1, #IOC_IRQ_MASK_B]
    LDMFD   SP!,{R0-R4}                 ; Restore state before exit.
    MOV     PC, R14                     ; Return to IRQ dispatch

; -------------------------------------------------------------
; Handle_KART_Rx - IRQ 15 handler
;
; Called when the KART has received a byte. Reads the byte from
; the IOC receive register and stores it in the Rx circular
; buffer. If the buffer is full, the byte is dropped.
;
; Entry: Called from IRQ dispatch. R0-R4 are saved by caller.
;        R14 = return address (ScanNextIRQ).
; -------------------------------------------------------------
.Handle_KART_Rx
    STMFD   SP!,{R0-R3}                 ; Preserve state while servicing IRQ.
    MOV     R1,#IOC_BaseAddr
    LDRB    R4,[R1,#IOC_KART_RX]        ; Read the received byte (clears IRQ)

    MOV     R0,#OS_Workspace
    LDR     R2,[R0, #OS_KRT_RxHead]     ; Get Rx write index
    ADD     R3,R2,#1                    ; Calculate next head position
    AND     R3,R3,#KRT_BufMask          ; Wrap around
    LDR     R1,[R0,#OS_KRT_RxTail]      ; Get Rx read index
    CMP     R3,R1                       ; Is the buffer full?
    LDMEQFD   SP!,{R0-R3}                 ; Restore state before exit.
    MOVEQ   PC,R14                      ; If full, drop the byte and return.

    MOV     R1,#KRT_RxBuffer            ; Get the Rx buffer base address
    STRB    R4,[R1,R2]                  ; Store the byte at the head position
    STR     R3,[R0,#OS_KRT_RxHead]      ; Advance the head index
    LDMFD   SP!,{R0-R3}                 ; Restore state before exit.
    MOV     PC, R14                     ; Return to IRQ dispatch

; =============================================================
; BUFFERED KART SEND/RECEIVE ROUTINES
;
; These routines provide non-polling access to the KART via
; the interrupt-driven circular buffers above.
; =============================================================

; -------------------------------------------------------------
; kart_buffered_send - Queue a byte for transmission
;
; Writes a byte into the Tx circular buffer. If the transmitter
; is idle (Tx IRQ was disabled by the handler after draining the
; buffer), the first byte is dequeued and written directly to
; IOC_KART_TX to kick off the transmission, then the Tx IRQ is
; re-enabled so the handler can send any remaining bytes.
; If a transmission is already in progress, the handler will
; pick up the new byte automatically.
;
; Entry:  R0 = byte to send
; Exit:   R0 = 0 on success, -1 if buffer full
; Corrupts: none (R1-R4 saved/restored)
; -------------------------------------------------------------
.kart_buffered_send
    STMFD   R13!, {R1-R4, R14}

    MOV     R4, #OS_Workspace
    LDR     R1, [R4, #OS_KRT_TxHead]   ; Get current Tx write index
    ADD     R2, R1, #1                 ; Calculate next head position
    AND     R2, R2, #KRT_BufMask       ; Wrap around
    LDR     R3, [R4, #OS_KRT_TxTail]   ; Get current Tx read index
    CMP     R2, R3                     ; Is the buffer full?
    BEQ     kart_buf_send_full

    MOV     R3, #KRT_TxBuffer          ; Get the Tx buffer base address
    STRB    R0, [R3, R1]               ; Store the byte at the head position
    STR     R2, [R4, #OS_KRT_TxHead]   ; Advance the head index

    ; Check whether the transmitter is currently active
    MOV     R3, #IOC_BaseAddr
    LDRB    R1, [R3, #IOC_IRQ_MASK_B]
    TST     R1, #IRQ_KART_TX           ; Is the Tx IRQ already enabled?
    BNE     kart_buf_send_done         ; Yes - handler is active, will send it.

    ; Transmitter is idle - dequeue the first byte and send it directly
    ; to start a new transmission.
    LDR     R2, [R4, #OS_KRT_TxTail]   ; Get current tail index
    MOV     R1, #KRT_TxBuffer
    LDRB    R1, [R1, R2]               ; Read the byte at the tail position
    ADD     R2, R2, #1                 ; Advance the tail index
    AND     R2, R2, #KRT_BufMask       ; Wrap around
    STR     R2, [R4, #OS_KRT_TxTail]   ; Update tail

    STRB    R1, [R3, #IOC_KART_TX]     ; Write byte to KART to start Tx

    ; Enable the Tx interrupt so the handler sends remaining bytes
    LDRB    R1, [R3, #IOC_IRQ_MASK_B]
    ORR     R1, R1, #IRQ_KART_TX       ; Set the Tx IRQ enable bit
    STRB    R1, [R3, #IOC_IRQ_MASK_B]

.kart_buf_send_done
    MOV     R0, #0                     ; Return success
    LDMFD   R13!, {R1-R4, PC}

.kart_buf_send_full
    MVN     R0, #0                     ; Return -1: buffer full
    LDMFD   R13!, {R1-R4, PC}

; -------------------------------------------------------------
; kart_buffered_receive - Read a byte from the receive buffer
;
; Returns the next byte from the Rx circular buffer without
; waiting. Returns -1 if no data is available.
;
; Entry:  none
; Exit:   R0 = received byte, or -1 if buffer empty
; Corrupts: none (R1-R3 saved/restored)
; -------------------------------------------------------------
.kart_buffered_receive
    STMFD   R13!, {R1-R3, R14}

    MOV     R3, #OS_Workspace
    LDR     R1, [R3, #OS_KRT_RxHead]   ; Get Rx write index
    LDR     R2, [R3, #OS_KRT_RxTail]   ; Get Rx read index
    CMP     R1, R2                     ; Is the buffer empty?
    BEQ     kart_buf_recv_empty

    MOV     R1, #KRT_RxBuffer          ; Get the Rx buffer base address
    LDRB    R0, [R1, R2]               ; Read the byte at the tail position
    ADD     R2, R2, #1                 ; Advance the tail index
    AND     R2, R2, #KRT_BufMask       ; Wrap around
    STR     R2, [R3, #OS_KRT_RxTail]   ; Store updated tail index

    LDMFD   R13!, {R1-R3, PC}

.kart_buf_recv_empty
    MVN     R0, #0                     ; Return -1: buffer empty
    LDMFD   R13!, {R1-R3, PC}

; -------------------------------------------------------------
; kart_buffered_receive_wait - Wait for and read a byte
;
; Blocks until a byte is available in the Rx circular buffer,
; then returns it. This polls the buffer indices in RAM rather
; than the IOC hardware registers directly.
;
; Entry:  none
; Exit:   R0 = received byte
; Corrupts: none (R1-R3 saved/restored)
; -------------------------------------------------------------
.kart_buffered_receive_wait
    STMFD   R13!, {R1-R3, R14}

    MOV     R3, #OS_Workspace
.kart_buf_recv_wait_loop
    LDR     R1, [R3, #OS_KRT_RxHead]   ; Get Rx write index
    LDR     R2, [R3, #OS_KRT_RxTail]   ; Get Rx read index
    CMP     R1, R2                     ; Is the buffer empty?
    BEQ     kart_buf_recv_wait_loop    ; Yes - keep waiting for IRQ to fill it

    MOV     R1, #KRT_RxBuffer          ; Get the Rx buffer base address
    LDRB    R0, [R1, R2]               ; Read the byte at the tail position
    ADD     R2, R2, #1                 ; Advance the tail index
    AND     R2, R2, #KRT_BufMask       ; Wrap around
    STR     R2, [R3, #OS_KRT_RxTail]   ; Store updated tail index

    LDMFD   R13!, {R1-R3, PC}

.kart_flush_receive
    STMFD   R13!, {R0-R1, R14}

    MOV     R1,#OS_Workspace
    MOV     R0,#0
    STR     R0,[R1,#OS_KRT_RxHead]      ; Set the Rx queue to an empty state.
    STR     R0,[R1,#OS_KRT_TxTail]

    ; Read the KART input byte to flush any pending IRQ.
    MOV     R1,#IOC_BaseAddr
    LDRB    R0,[R1,#IOC_KART_RX]
    STR     R0,[R1,#IOC_T3_GO]          ; Write a dummy value to the GO command
                                        ;    to restart the KART timer.

    LDMFD   R13!, {R0-R1, PC}           ; Return

.halt
    MOV R10,#BOOT_Completed             ; Set the current boot state
    STR R10,[R12,#OS_BootState]         ; Store the boot state

    BKPT 0
    B $
